# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/

# AI workflow artifacts (snapshots can grow large, regenerate from latest)
.understand-snapshots/

# Superpowers design artifacts (specs, plans, visual mocks, etc.)
# These are generated during AI-assisted design sessions and are not meant to be committed by default.
# Use `git add -f` if you intentionally want to commit a specific design doc.
docs/superpowers/

# Environment
.env
.env.local
.env.*.local

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Agent/runtime terminal snapshots (local only)
terminals/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test artifacts (large output dumps, not useful to commit)
test-results.json
test-results*.json
vitest-results*

# Misc
*.tgz
.cache/

# Active dictionary snapshot (generated by scripts/sync-dicts.js at runtime)
# This entire directory is generated and should not be committed.
app/src/data/dicts/active/


# Codegraph local index (do not commit)
.codegraph/


# Superpowers agent working directory (local only, contains brainstorming state, plans, etc.)
.superpowers/
