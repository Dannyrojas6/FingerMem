    { "en": "I think about my family.", "zh": "我想念我的家人。" },
    { "en": "You think this is a good book.", "zh": "你认为这是一本好书。" },
    { "en": "I know her name.", "zh": "我知道她的名字。" },
    { "en": "He knows the answer.", "zh": "他知道答案。" },
    { "en": "I want a glass of water.", "zh": "我想要一杯水。" },
    { "en": "She wants to see the doctor.", "zh": "她想看医生。" },
